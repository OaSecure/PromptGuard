PROMPTGUARD_ENV=development
PROMPTGUARD_TEMP_FILE_ENCRYPTION_KEY=
PROMPTGUARD_TEMP_FILE_DIR=.promptguard-temp
PROMPTGUARD_TEMP_FILE_TTL_SECONDS=900
PROMPTGUARD_TEMP_FILE_MAX_BYTES=1048576
PROMPTGUARD_API_HOST=0.0.0.0
PROMPTGUARD_API_PORT=8000
PROMPTGUARD_API_PUBLIC_URL=
PROMPTGUARD_EXTENSION_API_URL=
PROMPTGUARD_DASHBOARD_PUBLIC_URL=
PROMPTGUARD_DASHBOARD_STATIC_DIR=/opt/promptguard/dashboard
PROMPTGUARD_CORS_ORIGINS=http://localhost:8000,chrome-extension://placeholder
PROMPTGUARD_INITIAL_ADMIN_PASSWORD=1234

POSTGRES_DB=promptguard
POSTGRES_USER=promptguard
POSTGRES_PASSWORD=promptguard_dev_password
DATABASE_URL=postgresql+asyncpg://promptguard:promptguard_dev_password@postgres:5432/promptguard

REDIS_URL=

ACCESS_TOKEN_SECRET=change-me-access-token-secret
REFRESH_TOKEN_SECRET=change-me-refresh-token-secret
DASHBOARD_SESSION_SECRET=change-me-dashboard-session-secret
PROMPT_HASH_SECRET=change-me-prompt-hash-secret
PROMPT_HASH_KEY_ID=dev-key-1
ACCESS_TOKEN_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_DAYS=30
DASHBOARD_SESSION_EXPIRES_HOURS=12
DASHBOARD_SESSION_COOKIE_NAME=promptguard_dashboard_session
DASHBOARD_CSRF_COOKIE_NAME=promptguard_dashboard_csrf
DASHBOARD_COOKIE_SECURE=false
DASHBOARD_COOKIE_SAMESITE=lax
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

PROMPTGUARD_CLASSIFIER_RUNTIME_ENABLED=false
PROMPTGUARD_CLASSIFIER_MANIFEST_PATH=/opt/promptguard/models/context_lr_roberta_active_best_f1_manifest.json
PROMPTGUARD_QWEN_EMBEDDING_MODEL_PATH=/opt/promptguard/models/qwen3-embedding-0.6b
PROMPTGUARD_ML_INFERENCE_QUEUE_TIMEOUT_MS=120000
PROMPTGUARD_VERIFIER_RUNTIME_ENABLED=false
PROMPTGUARD_VERIFIER_MANIFEST_PATH=/opt/promptguard/models/context_lr_roberta_active_best_f1_manifest.json
PROMPTGUARD_TORCH_WORKER_PAYLOAD_DIR=/tmp/promptguard-torch-payloads
PROMPTGUARD_TORCH_WORKER_PYTHON_PATH=/opt/venvs/torch/bin/python
PROMPTGUARD_TORCH_WORKER_SCRIPT_PATH=/app/scripts/torch_context_worker.py
PROMPTGUARD_WORKER_READINESS_TIMEOUT_MS=120000
PROMPTGUARD_PADDLE_WORKER_PAYLOAD_DIR=/tmp/promptguard-paddle-payloads
PROMPTGUARD_PADDLE_WORKER_PYTHON_PATH=/opt/venvs/paddle/bin/python
PROMPTGUARD_PADDLE_WORKER_SCRIPT_PATH=/app/scripts/paddle_ocr_worker.py
